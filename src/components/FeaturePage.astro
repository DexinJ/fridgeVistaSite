---
import type { Locale } from "../lib/site";
import { routes } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = routes(locale);

const copy = {
  en: {
    label: "Everything in one kitchen view",
    title: "Know your kitchen. Use what you have.",
    intro:
      "FridgeVista connects inventory, freshness, photo entry, meal ideas, and the next shopping trip without turning dinner into another project.",
    cta: "Explore pricing",
    support: "Visit help center",
    sections: [
      {
        label: "Inventory",
        title: "A searchable view of every shelf.",
        text: "Keep fridge, freezer, and pantry items together. Search by name, filter by storage area, and see what is already at home before buying more.",
        image: "/images/promo/inventory-list.webp",
        alt: "FridgeVista inventory list with chicken breast, tortillas, and peas",
      },
      {
        label: "Freshness",
        title: "The next thing to use rises to the top.",
        text: "Expiration dates and urgency cues make it easier to choose what to eat next. Configure local reminders so fewer items disappear into the back of the fridge.",
        image: "/images/promo/expiry-cards.webp",
        alt: "FridgeVista home screen summarizing inventory and expiring food",
      },
      {
        label: "Photo capture",
        title: "Snap a shelf. Review what was found.",
        text: "Signed-in users can photograph a shelf, receipt, or drawer and review recognized groceries before adding them. Manual entry remains available for everything else.",
        image: "/images/promo/photo-screen-clean.webp",
        alt: "FridgeVista recognizing groceries from an open-fridge photograph",
      },
      {
        label: "AI and shopping",
        title: "Turn ingredients into a plan.",
        text: "Ask for recipe ideas built around what you already own. Add missing ingredients to a categorized shopping list, then check them off in shopping mode.",
        image: "/images/promo/recipe-screen-clean.webp",
        alt: "FridgeVista recipe results with ingredients already available",
      },
    ],
  },
  zh: {
    label: "从存放、到期，到下一餐",
    title: "看清家中食材，让厨房管理更简单。",
    intro: "记录家中食材，及时提醒临期食品。现有食材可以用来规划下一餐，缺少的材料则自动整理进购物清单。让买菜和做饭都更有条理。",
    cta: "看看方案",
    support: "前往帮助中心",
    sections: [
      {
        label: "先把东西放明白",
        title: "冰箱有什么，搜一下就找到。",
        text: "随手记录买回家的食材，将冷藏、冷冻和储物柜中的库存统一管理。支持搜索，并按存放位置、新鲜度或类别筛选，找食材不用再翻遍整个冰箱。",
        image: "/images/promo/inventory-list.webp",
        alt: "FridgeVista 按冷藏、冷冻和食品柜整理的食材列表",
      },
      {
        label: "优先处理临期食材",
        title: "快过期的食材，优先提醒。",
        text: "根据保质期和新鲜度整理食材，优先显示需要尽快食用的食品。还可以开启本机提醒，避免忘记处理冰箱里的食材。",
        image: "/images/promo/expiry-cards.webp",
        alt: "FridgeVista 首页显示库存数量和临期提醒",
      },
      {
        label: "少打几行字",
        title: "拍张照，先把食材认出来。",
        text: "拍摄冰箱、储物柜或购物收据，FridgeVista 会识别其中的食材。确认识别结果后，即可将食材添加到库存。",
        image: "/images/promo/photo-screen-clean.webp",
        alt: "FridgeVista 从一张冰箱照片里识别出多种食材",
      },
      {
        label: "把食材变成饭",
        title: "根据现有食材，轻松安排下一餐。",
        text: "让 AI 助手根据现有食材推荐菜谱。缺少的材料自动加入分类购物清单，购物时逐项勾选，买回家后再添加到库存。",
        image: "/images/promo/recipe-screen-clean.webp",
        alt: "FridgeVista 根据已有食材推荐的菜谱",
      },
    ],
  },
}[locale];
---

<section class="bg-cream py-16 sm:py-24">
  <div class="site-shell">
    <p class="section-label">{copy.label}</p>
    <h1 class="display-title mt-5 max-w-[11ch] text-balance text-5xl font-bold text-deep sm:text-7xl">{copy.title}</h1>
    <p class="mt-7 max-w-3xl text-pretty text-lg leading-8 text-ink/65 sm:text-xl">{copy.intro}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a class="button-primary px-7" href={path.pricing}>{copy.cta}</a>
      <a class="button-secondary px-7" href={path.support}>{copy.support}</a>
    </div>
  </div>
</section>

<section class="border-t border-deep/10 bg-paper">
  <div class="site-shell">
    {copy.sections.map((section, index) => (
      <article class:list={["grid items-center gap-10 py-16 sm:gap-14 sm:py-20 lg:grid-cols-2", index !== 0 && "border-t border-deep/10"]}>
        <div class:list={[index % 2 === 1 && "lg:order-2"]}>
          <p class="section-label">{section.label}</p>
          <h2 class="display-title mt-4 max-w-[11ch] text-balance text-4xl font-bold text-deep sm:text-5xl">{section.title}</h2>
          <p class="mt-5 max-w-xl text-pretty text-lg leading-8 text-ink/65">{section.text}</p>
        </div>
        <div class:list={["mx-auto w-full max-w-[29rem] rounded-[2rem] bg-cream p-3 sm:p-4", index % 2 === 1 && "lg:order-1"]}>
          <img
            class="w-full rounded-[1.4rem] border border-deep/10"
            src={section.image}
            width="720"
            height="1633"
            alt={section.alt}
            loading="eager"
          />
        </div>
      </article>
    ))}
  </div>
</section>

<section class="bg-mist py-20">
  <div class="site-shell flex flex-col items-start justify-between gap-8 rounded-[2rem] bg-paper p-8 shadow-lg shadow-deep/8 sm:flex-row sm:items-center sm:p-10">
    <div>
      <p class="font-display text-3xl font-bold text-deep">{locale === "zh" ? "下一餐，从看清厨房开始。" : "Ready for a clearer kitchen?"}</p>
      <p class="mt-2 text-ink/60">{locale === "zh" ? "基础功能无需注册即可使用，需要使用云端 AI 时再登录。" : "Start locally, then sign in when you want AI."}</p>
    </div>
    <a class="button-primary px-7" href={`${path.home}#download`}>{locale === "zh" ? "看看 FridgeVista" : "Get the app"}</a>
  </div>
</section>
