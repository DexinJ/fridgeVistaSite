<div class="relative mx-auto w-full max-w-[35rem]">
  <div class="absolute inset-x-[8%] bottom-[-1.5rem] h-[76%] rounded-[3rem] bg-mist" aria-hidden="true"></div>

  <div class="scan-frame relative mx-auto w-[19.2rem] max-w-full">
    <div class="phone-shadow relative overflow-hidden rounded-[2.9rem] border-[8px] border-deep bg-paper">
      <div class="absolute left-1/2 top-3 z-20 h-5 w-24 -translate-x-1/2 rounded-full bg-deep" aria-hidden="true"></div>

      <div class="min-h-[39rem] bg-[#fbfaf4] px-4 pb-5 pt-12">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-ink/55">Monday, 3 November</p>
            <h3 class="mt-1 font-display text-2xl font-bold text-deep">My kitchen</h3>
          </div>
          <span class="grid size-10 place-items-center rounded-full bg-mist text-deep" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="7" r="3.2" stroke="currentColor" stroke-width="1.6"></circle>
              <path d="M4.5 16c.8-3 2.7-4.5 5.5-4.5s4.7 1.5 5.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
        </div>

        <section class="mt-6 rounded-[1.6rem] bg-deep p-4 text-paper">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-semibold text-mist/70">Use these first</p>
              <p class="mt-1 font-display text-xl font-bold">3 items are close</p>
            </div>
            <span class="grid size-10 place-items-center rounded-full bg-coral text-white">
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 3v8l4 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"></circle>
              </svg>
            </span>
          </div>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <div class="rounded-2xl bg-white/9 p-2.5">
              <div class="grid size-9 place-items-center rounded-full bg-green text-sm font-bold text-white">S</div>
              <p class="mt-2 text-xs font-semibold">Spinach</p>
              <p class="mt-0.5 text-[0.68rem] text-coral">1 day left</p>
            </div>
            <div class="rounded-2xl bg-white/9 p-2.5">
              <div class="grid size-9 place-items-center rounded-full bg-sun text-sm font-bold text-deep">Y</div>
              <p class="mt-2 text-xs font-semibold">Yogurt</p>
              <p class="mt-0.5 text-[0.68rem] text-sun">3 days left</p>
            </div>
            <div class="rounded-2xl bg-white/9 p-2.5">
              <div class="grid size-9 place-items-center rounded-full bg-sky text-sm font-bold text-white">M</div>
              <p class="mt-2 text-xs font-semibold">Milk</p>
              <p class="mt-0.5 text-[0.68rem] text-mist">4 days left</p>
            </div>
          </div>
        </section>

        <div class="mt-5 flex gap-2 overflow-hidden text-[0.7rem] font-semibold">
          <span class="rounded-full bg-deep px-3 py-2 text-paper">All 12</span>
          <span class="rounded-full border border-deep/15 px-3 py-2 text-ink/70">Fridge 7</span>
          <span class="rounded-full border border-deep/15 px-3 py-2 text-ink/70">Freezer 3</span>
          <span class="rounded-full border border-deep/15 px-3 py-2 text-ink/70">Pantry 2</span>
        </div>

        <div class="mt-4 space-y-2.5">
          <div class="flex items-center gap-3 rounded-2xl border border-deep/10 bg-white p-3">
            <span class="grid size-10 flex-none place-items-center rounded-xl bg-mist text-base font-bold text-deep">S</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <p class="truncate text-sm font-bold text-deep">Baby spinach</p>
                <span class="rounded-full bg-[#ffe4dd] px-2 py-1 text-[0.61rem] font-bold text-alert">Use today</span>
              </div>
              <p class="mt-1 text-[0.7rem] text-ink/55">Fridge · 1 bag</p>
            </div>
          </div>
          <div class="flex items-center gap-3 rounded-2xl border border-deep/10 bg-white p-3">
            <span class="grid size-10 flex-none place-items-center rounded-xl bg-[#fff0c6] text-base font-bold text-deep">Y</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <p class="truncate text-sm font-bold text-deep">Greek yogurt</p>
                <span class="rounded-full bg-[#fff0c6] px-2 py-1 text-[0.61rem] font-bold text-deep">3 days</span>
              </div>
              <p class="mt-1 text-[0.7rem] text-ink/55">Fridge · 2 cups</p>
            </div>
          </div>
          <div class="flex items-center gap-3 rounded-2xl border border-deep/10 bg-white p-3">
            <span class="grid size-10 flex-none place-items-center rounded-xl bg-[#dceeff] text-base font-bold text-deep">M</span>
            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between gap-2">
                <p class="truncate text-sm font-bold text-deep">Whole milk</p>
                <span class="rounded-full bg-mist px-2 py-1 text-[0.61rem] font-bold text-deep">4 days</span>
              </div>
              <p class="mt-1 text-[0.7rem] text-ink/55">Fridge · 1 carton</p>
            </div>
          </div>
        </div>

        <div class="mt-5 flex items-center justify-between rounded-full bg-deep px-4 py-3 text-paper">
          <span class="flex items-center gap-2 text-xs font-bold">
            <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 5v10M5 10h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
            </svg>
            Add with a photo
          </span>
          <span class="grid size-7 place-items-center rounded-full bg-teal">
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 7h2l1.2-2h5.6L14 7h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.4"></path>
              <circle cx="10" cy="11.5" r="2.4" stroke="currentColor" stroke-width="1.4"></circle>
            </svg>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="absolute -left-4 top-[27%] hidden w-44 rounded-3xl border border-deep/10 bg-paper p-4 shadow-lg sm:block">
    <p class="text-xs font-bold text-teal">Photo scan complete</p>
    <p class="mt-1 text-sm font-semibold text-deep">6 groceries found</p>
    <div class="mt-3 flex -space-x-2">
      <span class="grid size-8 place-items-center rounded-full border-2 border-paper bg-green text-xs font-bold text-white">S</span>
      <span class="grid size-8 place-items-center rounded-full border-2 border-paper bg-sun text-xs font-bold text-deep">L</span>
      <span class="grid size-8 place-items-center rounded-full border-2 border-paper bg-coral text-xs font-bold text-white">T</span>
      <span class="grid size-8 place-items-center rounded-full border-2 border-paper bg-sky text-xs font-bold text-white">M</span>
    </div>
  </div>

  <div class="absolute -right-3 bottom-[20%] hidden w-44 rounded-3xl border border-deep/10 bg-paper p-4 shadow-lg sm:block">
    <p class="text-xs font-bold text-coral">Tonight’s idea</p>
    <p class="mt-1 text-sm font-semibold text-deep">Spinach &amp; yogurt flatbreads</p>
    <div class="mt-3 flex items-center gap-2 text-[0.68rem] font-semibold text-ink/60">
      <span class="size-2 rounded-full bg-green"></span>
      Uses 4 things you have
    </div>
  </div>
</div>
