---
import type { Locale } from "../lib/site";
import { routes } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = routes(locale);

const copy = {
  en: {
    label: "Simple plans",
    title: "Use the basics for free.",
    intro:
      "Your inventory, shopping lists, expiration tracking, and local reminders do not need an account or subscription. AI features use a starter allowance, with Plus available for heavier use.",
    free: "Free",
    plus: "FridgeVista Plus",
    freePrice: "No purchase required",
    plusPrice: "Available through the App Store",
    freeFeatures: [
      "Fridge, freezer, and pantry inventory",
      "Shopping lists and shopping mode",
      "Expiration tracking and local reminders",
      "Guest mode with on-device data",
      "Account access with a starter AI allowance",
    ],
    plusFeatures: [
      "Everything included in Free",
      "Higher hosted-AI usage",
      "Higher recipe-search limits",
      "Access to subscription features as shown in the app",
      "Manage or cancel through Apple",
    ],
    note:
      "Actual prices and renewal periods appear in the App Store before purchase. Subscriptions renew automatically unless canceled at least 24 hours before renewal. Deleting your FridgeVista account does not cancel an Apple subscription.",
    support: "Pricing questions",
    faq: "Read the help center",
  },
  zh: {
    label: "免费开始，按需升级",
    title: "基础功能免费使用，无需注册。",
    intro:
      "食材库存、购物清单、保质期管理和本机提醒均可免费使用，无需注册账号。",
    free: "免费",
    plus: "FridgeVista Plus",
    freePrice: "免费使用，无需购买或注册",
    plusPrice: "订阅方案及价格以 App Store 页面为准",
    freeFeatures: [
      "冷藏、冷冻、储物柜统一管理",
      "购物清单及购物模式",
      "保质期管理及本机提醒",
      "游客模式，数据仅保存在本机",
      "登录后可获得基础 AI 使用额度",
    ],
    plusFeatures: [
      "包含免费版全部功能",
      "更多云端 AI 使用额度",
      "更高的菜谱搜索额度",
      "享受应用内标明的 Plus 订阅权益",
      "管理或取消 Apple 订阅",
    ],
    note:
      "具体价格和续订周期以 App Store 页面为准。如不希望自动续订，请至少在续订时间前 24 小时取消订阅。删除 FridgeVista 账号不会取消 Apple 订阅。",
    support: "方案与价格咨询",
    faq: "前往帮助中心",
  },
}[locale];
---

<section class="bg-cream py-16 sm:py-24">
  <div class="site-shell">
    <p class="section-label">{copy.label}</p>
    <h1 class="display-title mt-5 max-w-[11ch] text-balance text-5xl font-bold text-deep sm:text-7xl">{copy.title}</h1>
    <p class="mt-7 max-w-3xl text-pretty text-lg leading-8 text-ink/65 sm:text-xl">{copy.intro}</p>
  </div>
</section>

<section class="bg-paper py-16 sm:py-20">
  <div class="site-shell grid items-stretch gap-5 lg:grid-cols-2">
    <article class="rounded-[2rem] border border-deep/10 bg-mist p-7 sm:p-10">
      <p class="font-display text-2xl font-bold text-deep">{copy.free}</p>
      <p class="mt-2 text-sm font-semibold text-ink/55">{copy.freePrice}</p>
      <ul class="mt-8 space-y-4">
        {copy.freeFeatures.map((feature) => (
          <li class="flex gap-3 text-sm leading-6 text-ink/70">
            <span class="mt-0.5 grid size-6 flex-none place-items-center rounded-full bg-green/15 text-green">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            {feature}
          </li>
        ))}
      </ul>
      <a class="button-secondary mt-9 w-full" href={`${path.home}#download`}>{locale === "zh" ? "获取 App" : "Get the app"}</a>
    </article>

    <article class="rounded-[2rem] bg-deep p-7 text-paper sm:p-10">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="font-display text-2xl font-bold">{copy.plus}</p>
          <p class="mt-2 text-sm font-semibold text-mist/65">{copy.plusPrice}</p>
        </div>
        <span class="rounded-full bg-sun px-3 py-1 text-xs font-bold text-deep">Plus</span>
      </div>
      <ul class="mt-8 space-y-4">
        {copy.plusFeatures.map((feature) => (
          <li class="flex gap-3 text-sm leading-6 text-mist/80">
            <span class="mt-0.5 grid size-6 flex-none place-items-center rounded-full bg-paper/10 text-mist">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m4 10 4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </span>
            {feature}
          </li>
        ))}
      </ul>
      <a class="mt-9 inline-flex min-h-13 w-full items-center justify-center rounded-full bg-paper px-6 font-bold text-deep hover:bg-cream" href={`${path.home}#download`}>
        {locale === "zh" ? "获取 App" : "Get the app"}
      </a>
    </article>
  </div>

  <div class="site-shell mt-8 rounded-2xl border border-deep/10 bg-cream p-5 text-sm leading-6 text-ink/60">
    <p>{copy.note}</p>
    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-bold text-teal">
      <a href={path.support}>{copy.support}</a>
      <a href={path.terms}>{locale === "zh" ? "使用条款" : "Terms of Use"}</a>
      <a href={path.privacy}>{locale === "zh" ? "隐私政策" : "Privacy Policy"}</a>
    </div>
  </div>
</section>

<section class="bg-cream py-16">
  <div class="site-shell text-center">
    <a class="inline-flex items-center gap-2 font-bold text-teal" href={path.support}>
      {copy.faq}
      <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>
