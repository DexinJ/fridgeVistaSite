---
import type { Locale } from "../lib/site";
import { routes, site } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const path = routes(locale);
const formUrl = site.forms[locale];

const copy = {
  en: {
    label: "FridgeVista help center",
    title: "Find the right place to start.",
    intro:
      "Browse help topics, check the common answers, or send a private request. FridgeVista is built by a small team, so we read every message and always handle privacy and account-deletion requests.",
    primary: "Start a support request",
    secondary: "Read common answers",
    helpful: "Before you submit",
    helpfulIntro:
      "Clear details help us reproduce a problem and reply without unnecessary back-and-forth.",
    checklist: [
      "The email address where you can receive a reply.",
      "Your FridgeVista account email or a note that you use guest mode.",
      "Your device, iOS or iPadOS version, and FridgeVista app version.",
      "What happened, what you expected, and how to reproduce it.",
      "An optional screenshot or screen recording, with personal details redacted.",
    ],
    categoriesLabel: "Choose a help topic",
    categories: [
      {
        title: "Using FridgeVista",
        text: "Inventory, shopping lists, expiry dates, reminders, and guest-mode questions.",
        tag: "App help",
      },
      {
        title: "Accounts & subscriptions",
        text: "Sign-in, account recovery, Apple purchases, renewals, and restore help.",
        tag: "Account",
      },
      {
        title: "AI & recipes",
        text: "Providers, photo recognition, recipe results, and usage limits.",
        tag: "AI help",
      },
      {
        title: "Bugs & crashes",
        text: "Errors, broken screens, performance, and reproducible app problems.",
        tag: "Report a bug",
      },
      {
        title: "Privacy & account deletion",
        text: "Data requests, permanent deletion, and help when you cannot sign in.",
        tag: "Privacy",
      },
      {
        title: "Ideas & translations",
        text: "Feature requests, wording improvements, and English or Chinese corrections.",
        tag: "Feedback",
      },
    ],
    requestTitle: "Open a private support request",
    requestText:
      "The request form collects the details needed to route account, privacy, billing, AI, and bug reports to the right place.",
    formNote: "Opens in a new tab",
    faqLabel: "Common questions",
    faq: [
      {
        q: "How quickly will I receive a reply?",
        a: "FridgeVista is supported by a small team. We cannot promise a reply to every message, but privacy and account-deletion requests are always handled.",
      },
      {
        q: "Can I get support without an account?",
        a: "Yes. Guest users can submit a request using any email address where they want to receive a reply. Enter N/A when the form asks for an account email.",
      },
      {
        q: "Should I ask for account deletion here?",
        a: "Deleting from the app is faster: open Settings > Account > Delete account. Use the request form if you cannot sign in or the in-app option does not work.",
      },
      {
        q: "What should I remove from screenshots?",
        a: "Hide email addresses, names, passwords, API keys, payment details, and any other sensitive information before attaching an image.",
      },
      {
        q: "Where do subscriptions get canceled?",
        a: "Manage subscriptions through Apple in iOS Settings or inside FridgeVista under Settings > Plan & Usage. Deleting a FridgeVista account does not cancel an App Store subscription.",
      },
    ],
    deletion: "Read the account deletion guide",
  },
  zh: {
    label: "FridgeVista 帮助中心",
    title: "遇到问题，先从这里找答案。",
    intro:
      "你可以先浏览常见问题，也可以提交私密支持请求。FridgeVista 由小团队维护，我们会认真查看每一条反馈，并妥善处理隐私及账号删除请求。",
    primary: "发支持请求",
    secondary: "先看常见问题",
    helpful: "提交请求前，请准备以下信息",
    helpfulIntro: "提供清晰、具体的信息，有助于我们准确定位问题，减少不必要的沟通。",
    checklist: [
      "能收到回复的邮箱。",
      "FridgeVista 账号邮箱；如果使用游客模式，请注明“游客模式”。",
      "手机或平板型号、系统版本，以及 FridgeVista 版本。",
      "问题的具体表现、预期结果，以及复现问题的操作步骤。",
      "可以附上截图或录屏（非必填），请先遮挡其中的个人信息。",
    ],
    categoriesLabel: "要找哪一类帮助？",
    categories: [
      {
        title: "使用与库存",
        text: "食材管理、购物清单、保质期提醒及游客模式相关问题。",
        tag: "日常使用",
      },
      {
        title: "账号与订阅",
        text: "登录、账号恢复、Apple 购买、订阅续订及购买恢复问题。",
        tag: "登录与购买",
      },
      {
        title: "AI 与菜谱",
        text: "照片识别不准确、菜谱推荐问题及 AI 使用额度。",
        tag: "智能功能",
      },
      {
        title: "故障与崩溃",
        text: "打不开、报错、卡顿，或者有能稳定重现的问题。",
        tag: "反馈故障",
      },
      {
        title: "隐私与账号删除",
        text: "数据相关请求、永久删除账号，以及无法登录时的处理方式。",
        tag: "数据相关",
      },
      {
        title: "功能建议与翻译反馈",
        text: "功能改进建议，以及中英文文案的修改意见。",
        tag: "功能与文案",
      },
    ],
    requestTitle: "把问题发给我们",
    requestText: "通过表单提交问题及联系方式。所有支持请求均为私密提交，不会公开显示在网站上，我们会根据问题类型转交处理。",
    formNote: "新标签页打开",
    faqLabel: "常见问题",
    faq: [
      {
        q: "多久会回复？",
        a: "FridgeVista 由小团队提供支持。我们无法保证回复每一条消息，但会妥善处理所有隐私及账号删除请求。",
      },
      {
        q: "没账号也能提问吗？",
        a: "可以。只需填写一个能够接收回复的邮箱；如果没有 FridgeVista 账号，请在账号邮箱栏填写“不适用”。",
      },
      {
        q: "想删账号，要在这里申请吗？",
        a: "能进入应用时，请在设置 > 账号 > 删除账号中操作。如果无法登录或应用内删除功能不可用，请提交支持请求。",
      },
      {
        q: "截图里要遮掉什么？",
        a: "请遮挡邮箱地址、姓名、密码、API 密钥、付款信息及其他敏感个人信息。",
      },
      {
        q: "订阅去哪里取消？",
        a: "前往 iOS 设置中的 Apple 账户 > 订阅，或在应用内打开“设置 > 计划与用量”管理订阅。删除 FridgeVista 账号不会取消 App Store 订阅。",
      },
    ],
    deletion: "查看账号删除指南",
  },
}[locale];
---

<section class="overflow-hidden bg-cream pb-20 pt-14 sm:pt-20">
  <div class="site-shell grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
    <div>
      <p class="section-label">{copy.label}</p>
      <h1 class="display-title mt-5 max-w-[10ch] text-balance text-5xl font-bold text-deep sm:text-6xl">
        {copy.title}
      </h1>
      <p class="mt-6 max-w-2xl text-pretty text-lg leading-8 text-ink/68">
        {copy.intro}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="button-primary px-7" href={formUrl} target="_blank" rel="noopener noreferrer">
          {copy.primary}
          <svg width="17" height="17" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M7 13 13 7M8 7h5v5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="button-secondary px-6" href="#common-questions">{copy.secondary}</a>
      </div>
    </div>

    <aside class="rounded-[2rem] bg-paper p-6 shadow-lg shadow-deep/8 sm:p-8" aria-labelledby="request-checklist">
      <div class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-2xl bg-mist text-teal">
          <svg width="21" height="21" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 5h14v14H5V5Z" stroke="currentColor" stroke-width="1.7"></path>
            <path d="m8 12 2.3 2.3L16 8.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <h2 class="font-display text-2xl font-bold text-deep" id="request-checklist">{copy.helpful}</h2>
      </div>
      <p class="mt-4 text-pretty leading-7 text-ink/62">{copy.helpfulIntro}</p>
      <ul class="mt-6 space-y-3">
        {copy.checklist.map((item) => (
          <li class="flex gap-3 text-sm leading-6 text-ink/70">
            <span class="mt-2 size-1.5 flex-none rounded-full bg-green"></span>
            {item}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<section class="border-y border-deep/10 bg-paper py-20 sm:py-24">
  <div class="site-shell">
    <h2 class="display-title max-w-[12ch] text-balance text-4xl font-bold text-deep sm:text-5xl">{copy.categoriesLabel}</h2>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {copy.categories.map((category, index) => (
        <a
          class="group flex min-h-56 flex-col rounded-[1.6rem] border border-deep/12 bg-cream p-6 hover:border-teal"
          href={`${formUrl}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="rounded-full bg-paper px-3 py-1 text-xs font-bold text-teal">{category.tag}</span>
            <span class="font-display text-sm font-bold text-ink/35 tabular-nums">0{index + 1}</span>
          </div>
          <h3 class="mt-7 font-display text-2xl font-bold text-deep">{category.title}</h3>
          <p class="mt-3 text-pretty text-sm leading-6 text-ink/62">{category.text}</p>
          <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold text-teal">
            {copy.primary}
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="bg-deep py-20 text-paper sm:py-24">
  <div class="site-shell grid items-center gap-10 lg:grid-cols-[1fr_auto]">
    <div>
      <p class="text-sm font-bold text-mist/70">{copy.label}</p>
      <h2 class="display-title mt-3 max-w-[12ch] text-balance text-4xl font-bold sm:text-5xl">{copy.requestTitle}</h2>
      <p class="mt-5 max-w-2xl text-pretty leading-7 text-mist/72">{copy.requestText}</p>
    </div>
    <a class="inline-flex min-h-13 items-center justify-center gap-3 rounded-full bg-paper px-7 py-3 font-bold text-deep hover:bg-cream" href={formUrl} target="_blank" rel="noopener noreferrer">
      {copy.primary}
      <span class="text-xs font-medium text-ink/50">{copy.formNote}</span>
    </a>
  </div>
</section>

<section class="py-20 sm:py-24" id="common-questions">
  <div class="site-shell grid gap-12 lg:grid-cols-[0.7fr_1.3fr]">
    <div>
      <p class="section-label">{copy.faqLabel}</p>
      <h2 class="display-title mt-5 text-balance text-4xl font-bold text-deep sm:text-5xl">
        {locale === "zh" ? "发请求前，先看看。" : "Before you submit."}
      </h2>
      <a class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-teal" href={path.deletion}>
        {copy.deletion}
        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
    <div>
      {copy.faq.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary>{item.q}</summary>
          <p class="max-w-2xl pb-5 text-pretty leading-7 text-ink/65">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
