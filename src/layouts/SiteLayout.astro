---
import BrandMark from "../components/BrandMark.astro";
import "../styles/global.css";
import { alternatePath, labels, routes, site, type Locale } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const {
  title = "FridgeVista — Know what's inside. Cook what's next.",
  description = "Track your fridge, freezer, and pantry, catch food before it expires, and turn what you already have into dinner.",
  locale = "en",
} = Astro.props;

const copy = labels[locale];
const path = routes(locale);
const alternate = alternatePath(Astro.url.pathname);
const base = Astro.site ?? new URL("https://fridgevista.com");
const canonical = new URL(Astro.url.pathname, base);
const alternateUrl = new URL(alternate, base);
const iconUrl = new URL(site.iconUrl, base);
const appHref = site.appStoreUrl || `${path.home}#download`;
const footerText =
  locale === "zh"
    ? "看清家中食材，及时用好每一份食物，让每一餐都更轻松。"
    : "A calmer way to see your kitchen, use what you have, and make room for better meals.";
---

<!doctype html>
<html lang={locale === "zh" ? "zh-Hans" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d4e4ca" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale === "zh" ? "en" : "zh-Hans"} href={alternateUrl} />
    <link rel="alternate" hreflang={locale === "zh" ? "zh-Hans" : "en"} href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "zh" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={iconUrl} />
    <link rel="icon" href={site.iconUrl} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const requested = new URLSearchParams(window.location.search).get("lang");
        const path = window.location.pathname;

        if ((requested === "zh" || requested === "zh-Hans") && !path.startsWith("/zh/")) {
          const target = path === "/" ? "/zh/" : `/zh${path}`;
          window.location.replace(`${target}${window.location.hash}`);
        }

        if (requested === "en" && path.startsWith("/zh/")) {
          const target = path.slice(3) || "/";
          window.location.replace(`${target}${window.location.hash}`);
        }
      })();
    </script>
  </head>
  <body>
    <header class="relative z-30 border-b border-deep/10 bg-cream">
      <div class="site-shell flex min-h-20 items-center justify-between gap-6">
        <BrandMark href={path.home} />

        <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
          <a class="nav-link" href={path.features}>{copy.features}</a>
          <a class="nav-link" href={`${path.home}#how-it-works`}>{copy.howItWorks}</a>
          <a class="nav-link" href={path.pricing}>{copy.pricing}</a>
          <a class="nav-link" href={path.support}>{copy.support}</a>
        </nav>

        <div class="hidden items-center gap-3 lg:flex">
          <a
            class="text-sm font-semibold text-ink/65 hover:text-teal"
            href={alternate}
            hreflang={locale === "zh" ? "en" : "zh-Hans"}
            lang={locale === "zh" ? "en" : "zh-Hans"}
          >
            {copy.language}
          </a>
          <a class="button-secondary px-5 text-sm" href={appHref}>
            {copy.getApp}
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </a>
        </div>

        <details class="relative lg:hidden">
          <summary
            class="grid size-11 cursor-pointer list-none place-items-center rounded-full border border-deep/20 bg-paper"
            aria-label="Open navigation menu"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            </svg>
          </summary>
          <nav
            class="absolute right-0 top-14 w-64 rounded-3xl border border-deep/10 bg-paper p-5 shadow-xl"
            aria-label="Mobile navigation"
          >
            <div class="grid gap-1">
              <a class="rounded-xl px-3 py-3 font-semibold text-deep hover:bg-mist" href={path.features}>{copy.features}</a>
              <a class="rounded-xl px-3 py-3 font-semibold text-deep hover:bg-mist" href={`${path.home}#how-it-works`}>{copy.howItWorks}</a>
              <a class="rounded-xl px-3 py-3 font-semibold text-deep hover:bg-mist" href={path.pricing}>{copy.pricing}</a>
              <a class="rounded-xl px-3 py-3 font-semibold text-deep hover:bg-mist" href={path.support}>{copy.support}</a>
              <a
                class="rounded-xl px-3 py-3 font-semibold text-deep hover:bg-mist"
                href={alternate}
                hreflang={locale === "zh" ? "en" : "zh-Hans"}
                lang={locale === "zh" ? "en" : "zh-Hans"}
              >
                {copy.language}
              </a>
              <a class="mt-2 rounded-full bg-deep px-4 py-3 text-center font-bold text-paper" href={appHref}>{copy.getApp}</a>
            </div>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bg-deep text-paper">
      <div class="site-shell grid gap-12 py-14 md:grid-cols-[1.5fr_1fr_1fr]">
        <div>
          <BrandMark inverted href={path.home} />
          <p class="mt-5 max-w-sm text-pretty text-sm leading-6 text-mist/75">
            {footerText}
          </p>
        </div>

        <div>
          <p class="font-display text-lg font-semibold">{locale === "zh" ? "浏览" : "Explore"}</p>
          <div class="mt-4 grid gap-3 text-sm text-mist/80">
            <a class="hover:text-paper" href={path.features}>{copy.features}</a>
            <a class="hover:text-paper" href={`${path.home}#how-it-works`}>{copy.howItWorks}</a>
            <a class="hover:text-paper" href={path.pricing}>{copy.pricing}</a>
          </div>
        </div>

        <div>
          <p class="font-display text-lg font-semibold">{locale === "zh" ? "帮助与条款" : "Support & legal"}</p>
          <div class="mt-4 grid gap-3 text-sm text-mist/80">
            <a class="hover:text-paper" href={path.support}>{copy.support}</a>
            <a class="hover:text-paper" href={path.privacy}>{copy.privacy}</a>
            <a class="hover:text-paper" href={path.terms}>{copy.terms}</a>
            <a class="hover:text-paper" href={path.deletion}>{copy.deletion}</a>
            <a class="hover:text-paper" href={path.subprocessors}>{copy.subprocessors}</a>
            <a class="hover:text-paper" href={path.licenses}>{copy.licenses}</a>
          </div>
        </div>
      </div>
      <div class="site-shell flex flex-col gap-3 border-t border-paper/15 py-6 text-xs text-mist/65 sm:flex-row sm:items-center sm:justify-between">
        <p>© 2026 FridgeVista. {locale === "zh" ? "保留所有权利。" : "All rights reserved."}</p>
        <p>{locale === "zh" ? "为 iPhone 和 iPad 打造。" : "Made for iPhone and iPad."}</p>
      </div>
    </footer>
  </body>
</html>
