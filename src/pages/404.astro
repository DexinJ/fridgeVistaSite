---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found — FridgeVista" description="The requested FridgeVista page could not be found.">
  <section class="bg-cream py-24 sm:py-32">
    <div class="site-shell">
      <p class="section-label">404</p>
      <h1 class="display-title mt-5 max-w-[10ch] text-balance text-5xl font-bold text-deep sm:text-7xl">
        This shelf is empty.
      </h1>
      <p class="mt-6 max-w-xl text-pretty text-lg leading-8 text-ink/65">
        The page may have moved, or the link may be out of date. Start from the kitchen overview or visit support.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a class="button-primary px-7" href="/">Back to FridgeVista</a>
        <a class="button-secondary px-7" href="/support/">Visit help center</a>
      </div>
    </div>
  </section>
</SiteLayout>
